# Linux: run the bot in the background and start it again after a reboot.
#
# 1. Run `python3 main.py` once by hand to set up your settings and games.
# 2. Change YOUR_USER and the two paths below.
# 3. sudo cp steam-price-alert.service /etc/systemd/system/
#    sudo systemctl daemon-reload
#    sudo systemctl enable --now steam-price-alert
# 4. Logs: journalctl -u steam-price-alert -f

[Unit]
Description=Steam Game Price Alert
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=YOUR_USER
WorkingDirectory=/home/YOUR_USER/Steam-Game-Price-Alert/Steam-Game-Price-Alert
ExecStart=/usr/bin/python3 main.py --daemon
Environment=PYTHONUNBUFFERED=1
Restart=on-failure
RestartSec=60

[Install]
WantedBy=multi-user.target
